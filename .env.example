# Copy this file to .env and fill it in yourself. .env is never committed.

# Free. Raises PubMed from 3 to 10 requests per second.
# https://account.ncbi.nlm.nih.gov/settings/ → "API Key Management"
NCBI_API_KEY=

# Free, required by OpenAlex since February 2026. https://openalex.org/settings/api
OPENALEX_API_KEY=

# Sent to PubMed, Europe PMC, Crossref and Unpaywall so they can contact the project
# if something goes wrong. Unpaywall does not work without it.
CONTACT_EMAIL=

# Full texts through EPFL's subscriptions. Both work only on the EPFL network or VPN (access
# is checked by IP address) and only for non-commercial research. Ask the library first
# whether EPFL has its own text-mining agreement with these publishers.
# Free Elsevier account: https://dev.elsevier.com/ → "I want an API key"
ELSEVIER_API_KEY=
# Free Wiley Online Library account; accept the text-mining licence at
# https://onlinelibrary.wiley.com/library-info/resources/text-and-datamining
WILEY_TDM_TOKEN=

# Paid-tier key only (on the free tier Google may read and reuse what is sent).
# Needed from the end of Phase 1.
GEMINI_API_KEY=
